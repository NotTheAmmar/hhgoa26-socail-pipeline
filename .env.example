# =============================================================================
# Face ID & Blockchain Verification Pipeline — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# --- SerpAPI (Google Lens reverse image search) ---
# Free tier: 250 searches/month, no credit card required
# Sign up at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# --- imgbb (temporary public image hosting for SerpAPI) ---
# Free, no credit card required
# Sign up at: https://imgbb.com/api
IMGBB_API_KEY=your_imgbb_api_key_here

# --- Flask ---
FLASK_SECRET_KEY=change_me_to_a_random_secret
FLASK_DEBUG=false

# --- Blockchain ---
# Local Hardhat node URL (default, no change needed for local dev)
HARDHAT_RPC_URL=http://127.0.0.1:8545
